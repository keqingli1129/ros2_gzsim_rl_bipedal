          <geometry><box><size>0.05 0.05 0.35</size></box></geometry>
        </collision>
      </link>

      <link name="foot_R">
        <pose>0 -0.06 0.03 0 0 0</pose>
        <inertial>
          <mass>0.5</mass>
          <inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
